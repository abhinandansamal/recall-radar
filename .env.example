# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Real values for test/prod live in Azure Key Vault, never here.

# --- Environment: dev | test | prod ---
RR_APP_ENV=dev
RR_SERVICE_NAME=api
RR_LOG_LEVEL=INFO

# --- LLM (Mistral) ---
RR_MISTRAL_API_KEY=replace-me

# --- Database (local Docker: see docker-compose.dev.yml) ---
RR_POSTGRES_HOST=localhost
RR_POSTGRES_PORT=5432
RR_POSTGRES_DB=rr_dev
RR_POSTGRES_USER=rr_app
RR_POSTGRES_PASSWORD=replace-me-local-only

# --- Cache ---
RR_REDIS_URL=redis://localhost:6379/0

# --- Observability (Langfuse Cloud, EU region) ---
RR_LANGFUSE_HOST=https://cloud.langfuse.com
RR_LANGFUSE_PUBLIC_KEY=replace-me
RR_LANGFUSE_SECRET_KEY=replace-me

# --- Notifications ---
RR_DISCORD_WEBHOOK_URL=replace-me
RR_GMAIL_SMTP_USER=replace-me@gmail.com
RR_GMAIL_APP_PASSWORD=replace-me
